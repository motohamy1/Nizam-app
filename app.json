{
  "expo": {
    "name": "Nizam",
    "slug": "nizam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nizam.png",
    "scheme": "nizamapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motohamy.nizamapp"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0E0F14",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.motohamy.nizamapp",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nizam.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nizam.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/alarm_tone.wav",
            "./assets/sounds/timer_done.wav",
            "./assets/sounds/subtask_done.wav",
            "./assets/sounds/reminder.wav",
            "./assets/sounds/success.wav",
            "./assets/sounds/morning.wav",
            "./assets/sounds/evening.wav",
            "./assets/sounds/overdue.wav"
          ]
        }
      ],
      "expo-task-manager",
      "expo-localization",
      "expo-status-bar",
      "expo-audio",
      "expo-image-picker",
      "expo-document-picker",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "933ab2d7-9343-4d11-b37c-0a5b7d25061c"
      }
    },
    "owner": "motohamy735"
  }
}
