  const paddingBottom = Math.max(insets.bottom, 0);
  const dockHeight = DOCK_HEIGHT + paddingBottom;
  const dockFill = isDarkMode ? '#111510' : '#FFFFFF';
  const dockStroke = isDarkMode ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.06)';
