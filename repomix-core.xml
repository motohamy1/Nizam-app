            onPress: () => {
              if (selectedItem && !selectedItem.isSample) {
                deleteTodo({ id: selectedItem._id });
              }
            },
          },
        ]}
      />

      {/* ─── Screen Guide Tips ────────────────────────────────────── */}
      <ScreenGuide
        visible={showGuide}
        tips={tips}
        onDismiss={dismissGuide}
        isArabic={isArabic}
      />
    </SafeAreaView>
  );
}
