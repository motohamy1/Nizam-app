            <TouchableOpacity
              onPress={() => router.back()}
              hitSlop={{ top: 10, bottom: 10, left: 10, right: 10 }}
              style={styles.headerIconBtn}
            >
              <Ionicons
                name={isArabic ? 'arrow-forward' : 'arrow-back'}
                size={24}
                color={colors.text}
              />
