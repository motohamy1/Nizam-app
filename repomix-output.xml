                          backgroundColor: isSubDone ? colors.success : 'transparent',
                          justifyContent: 'center',
                          alignItems: 'center',
                        }}
                      >
                        {isSubDone && <Ionicons name="checkmark" size={10} color="#FFFFFF" />}
                      </TouchableOpacity>

                      <TouchableOpacity 
                        style={{ flex: 1 }} 
                        onPress={() => onOpenDetail(sub._id, 'subtask')}
