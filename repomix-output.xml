                </TouchableOpacity>

                <TouchableOpacity
                  activeOpacity={0.8}
                  onPress={handleDone}
                  style={{
                    flexDirection: isArabic ? 'row-reverse' : 'row',
                    alignItems: 'center',
                    gap: 4,
                    backgroundColor: colors.success,
                    paddingHorizontal: 9,
                    paddingVertical: 4.5,
                    borderRadius: 10,
