  initialDate?: number;
  projectId?: string;
  onFocus?: () => void;
}


import { useTranslation } from "@/utils/i18n";
import { useRouter } from "expo-router";

const TodoInput: React.FC<TodoInputProps> = ({ initialDate, projectId, onFocus }) => {
