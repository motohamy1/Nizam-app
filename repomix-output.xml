                >
                  <Ionicons name="checkmark" size={12} color="#0E0F14" />
                  <Text style={{ fontSize: 11, fontWeight: '800', color: '#0E0F14' }}>
                    {isArabic ? 'إتمام' : 'Done'}
                  </Text>
                </TouchableOpacity>
              </>
            )}

            {/* 3. Not Started / Overdue Status: Start Button + Done Check Button */}
