            </TouchableOpacity>
          </Animated.View>

          <Text style={styles.versionText}>VERSION 1.0.4 (BETA)</Text>
        </ScrollView>
      </SafeAreaView>

      <ScreenGuide visible={showGuide} tips={settingsTips} onDismiss={dismissGuide} isArabic={isArabic} />
    </View>
