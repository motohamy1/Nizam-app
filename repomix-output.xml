                      onPress: () => Share.share({ message: `Project: ${project.name}\n${project.description || ''}` })
                    },
                    {
                      label: isArabic ? 'حذف المشروع' : 'Delete Project',
                      icon: 'trash-outline',
                      variant: 'destructive',
                      onPress: () => onDeleteProject(project._id)
