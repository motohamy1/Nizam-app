                    </View>

                    <Text style={{ fontWeight: '800', color: colors.text }}>:</Text>

                    {/* Minute Selector */}
                    <TouchableOpacity
                      style={[styles.minuteToggleBtn, { borderColor: colors.border }]}
                      onPress={() => {
                        const next = selectedMinute === 0 ? 15 : selectedMinute === 15 ? 30 : selectedMinute === 30 ? 45 : 0;
